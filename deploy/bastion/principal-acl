# /etc/bastionhub/principal-acl
#
# Read by /usr/local/bin/principal-to-acl. One principal per line, followed by
# the host:port destinations a certificate carrying that principal may open
# through gw-passthrough:
#
#   <principal> <host:port> [<host:port> ...]

# Forward to the bastion's own sshd.
gw-edge-ssh-test-loopback 127.0.0.1:22

# Forward to perso-mbp's reverse-tunnel port.
gw-edge-ssh-test-perso-mbp 127.0.0.1:12001
